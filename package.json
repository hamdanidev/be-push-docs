{
  "name": "push-docs",
  "version": "1.1.0",
  "private": true,
  "description": "Backfill script + API untuk regenerasi dokumen klaim",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "api": "node server.js",
    "dry-run": "node index.js --dry-run",
    "test-1": "node index.js --limit=3",
    "retry-skipped": "node index.js --retry-skipped",
    "chunk1": "node index.js --range=01-08 --from=01-06-2026 --to=08-06-2026 --concurrency=5 --gabung-tindakan",
    "chunk2": "node index.js --range=09-15 --from=09-06-2026 --to=15-06-2026 --concurrency=5 --gabung-tindakan",
    "chunk3": "node index.js --range=16-23 --from=16-06-2026 --to=23-06-2026 --concurrency=5 --gabung-tindakan",
    "chunk4": "node index.js --range=24-30 --from=24-06-2026 --to=30-06-2026 --concurrency=5 --gabung-tindakan"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.7",
    "express": "^4.22.3"
  }
}
