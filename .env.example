# ══════════════════════════════════════════════════════════════
# PUSH DOCS — ENV TEMPLATE
# ══════════════════════════════════════════════════════════════
# Copy file ini ke `.env` lalu isi nilai yang kosong.
#
#   cp .env.example .env          (Linux/Mac)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# Dua mode pemakaian — BISA JALAN BARENG:
#
#   1. API mode  → `npm run api`     (server.js)
#      - Auth via Bearer token dari header request
#      - API_USERNAME / API_PASSWORD TIDAK dipakai
#      - Expose HTTP di PORT
#      - Simpan job ke output/jobs.db
#
#   2. CLI mode  → `npm start` / `npm run chunk1..4`   (index.js)
#      - Auth via API_USERNAME / API_PASSWORD
#      - Tidak expose HTTP
#      - Simpan hasil ke output/success-<range>.jsonl
#
# Keduanya pakai .env yang sama. Tidak ada konflik karena:
#   - File output berbeda (suffix beda)
#   - Variabel yang dipakai tidak overlap (CLI vs API only)
#   - jobs.db pakai WAL mode (concurrent-safe)
#
# ══════════════════════════════════════════════════════════════
API_BASE_URL=http://22.22.22.11:9090/v1.0
REQUEST_TIMEOUT=180000

# ══════════════════════════════════════════════════════════════
# 2) KREDENSIAL CLI MODE (opsional — hanya untuk index.js)
# ══════════════════════════════════════════════════════════════
# Dipakai oleh `npm start`, `npm run chunk1..4`, dll.
# Biarkan KOSONG kalau hanya pakai API mode.
API_USERNAME=
API_PASSWORD=

# ══════════════════════════════════════════════════════════════
# 3) API SERVER (WAJIB untuk API mode)
# ══════════════════════════════════════════════════════════════
PORT=3001

# Berapa lama hasil verifikasi token di-cache (ms).
# Selama window ini, token yang sama tidak akan hit SIMRS lagi.
# 300000 = 5 menit. Turunkan ke 60000 kalau butuh revoke cepat.
AUTH_CACHE_TTL_MS=300000

# ══════════════════════════════════════════════════════════════
# 4) FILTER PASIEN (default, bisa di-override via request body / CLI)
# ══════════════════════════════════════════════════════════════
# Format tanggal WAJIB DD-MM-YYYY.
TANGGAL_AWAL=01-06-2026
TANGGAL_AKHIR=30-06-2026
KD_INSTALASI=1
CARA_BAYAR=bpjs
STATUS_CASE_MIX=final
LIMIT_PASIEN=6000
GABUNG_TINDAKAN=true

# ══════════════════════════════════════════════════════════════
# 5) BEHAVIOR
# ══════════════════════════════════════════════════════════════
CONCURRENCY=5
RETRY_COUNT=5
SKIP_HANDLED_BY_FE=true
SAVE_TO_RM=true
RETRY_SKIPPED=false